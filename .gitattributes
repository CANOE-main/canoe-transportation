# Keep source/configuration scripts usable with Unix tools and shebangs even
# when a contributor has core.autocrlf=true. Binary files retain their bytes.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sqlite binary
*.sqlite3 binary
*.db binary
*.xls binary
*.xlsx binary
*.xlsm binary
*.xla binary
*.pptx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
*.gz binary

# Registered external-model files must retain their exact checksum-pinned bytes
# on every platform; disable Git text conversion for these current source paths.
inputs/0_external_models/epa_omega_ldv_range_extract/*.csv -text
inputs/0_external_models/ramp_mobility/results/** -text
inputs/validation/transportation_reference/charger_costs/*.csv -text whitespace=cr-at-eol

# These RAMP artifacts have LF Git blobs and registered native CRLF bytes.
# Restore the pinned serialization at checkout independently of core.autocrlf.
"inputs/0_external_models/ramp_mobility/results/**/Charging Profiles.csv" text eol=crlf
inputs/0_external_models/ramp_mobility/results/**/run_metadata.json text eol=crlf
