from fetching.cer_enerfuture import configured_edition
from utils import load_config_bundle, load_harmonization_rules


SCENARIO_PATH = config.get(
    "scenario",
    "config/scenarios/legacy_reproduction.yaml",
)
SCENARIO = load_config_bundle(SCENARIO_PATH)
CER_EDITION = str(configured_edition(SCENARIO))
CER_RULES = load_harmonization_rules(SCENARIO, "cer_enerfuture")
STATCAN_RULES = load_harmonization_rules(SCENARIO, "statcan_tables")
INTERIM_ROOT = SCENARIO.paths.inputs.interim.rstrip("/\\")
LOG_ROOT = SCENARIO.paths.outputs.logs.rstrip("/\\")
SQLITE_ROOT = SCENARIO.paths.outputs.sqlite.rstrip("/\\")
CER_INTERIM = (
    f"{INTERIM_ROOT}/"
    f"{CER_RULES['interim_subdir_template'].format(edition=CER_EDITION)}"
)
STATCAN_INTERIM = f"{INTERIM_ROOT}/{STATCAN_RULES['interim_subdir']}"
STATCAN_MANIFEST = f"{STATCAN_INTERIM}/{STATCAN_RULES['manifest_file']}"
STATCAN_WARNINGS = f"{STATCAN_INTERIM}/{STATCAN_RULES['warnings_file']}"
CER_MANIFEST = f"{CER_INTERIM}/{CER_RULES['manifest_file']}"
CER_WARNINGS = f"{CER_INTERIM}/{CER_RULES['warnings_file']}"
DOCTOR_OUTPUT = f"{LOG_ROOT}/doctor.ok"
TRANSPORT_DATABASE = f"{SQLITE_ROOT}/{SCENARIO.scenario.outputs.sqlite_name}"
TRANSPORT_VALIDATION = SCENARIO.scenario.outputs.validation_report
CACHE_FLAG = "" if SCENARIO.scenario.switches.download_sources else "--no-download"


rule all:
    input:
        DOCTOR_OUTPUT,
        STATCAN_MANIFEST,
        STATCAN_WARNINGS,
        CER_MANIFEST,
        CER_WARNINGS,
        TRANSPORT_DATABASE,
        TRANSPORT_VALIDATION,


rule doctor_smoke:
    output:
        DOCTOR_OUTPUT
    params:
        scenario=SCENARIO_PATH,
    run:
        import subprocess
        from pathlib import Path

        subprocess.run(
            ["uv", "run", "python", "scripts/doctor.py", "--scenario", params.scenario],
            check=True,
        )
        output_path = Path(output[0])
        output_path.parent.mkdir(parents=True, exist_ok=True)
        output_path.write_text("ok\n", encoding="utf-8")


rule statcan_transport_tables:
    output:
        manifest=STATCAN_MANIFEST,
        warnings=STATCAN_WARNINGS,
    params:
        scenario=SCENARIO_PATH,
        cache_flag=CACHE_FLAG,
    shell:
        "uv run python -m fetching.statcan_tables "
        "--scenario {params.scenario:q} {params.cache_flag}"


rule cer_enerfuture:
    output:
        manifest=CER_MANIFEST,
        warnings=CER_WARNINGS,
    params:
        scenario=SCENARIO_PATH,
        edition=CER_EDITION,
        cache_flag=CACHE_FLAG,
    shell:
        "uv run python -m fetching.cer_enerfuture "
        "--scenario {params.scenario:q} --edition {params.edition:q} "
        "{params.cache_flag}"


rule transport_database:
    input:
        doctor=DOCTOR_OUTPUT,
        paths="config/paths.yaml",
        sources="config/sources.yaml",
        scenario=SCENARIO_PATH,
        technology="inputs/0_canoe_template/technology.csv",
        commodity="inputs/0_canoe_template/commodity.csv",
    output:
        database=TRANSPORT_DATABASE,
        validation=TRANSPORT_VALIDATION,
    shell:
        "uv run python src/build_transport.py "
        "--scenario {input.scenario:q} --overwrite"
