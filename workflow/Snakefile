configfile: "config/paths.yaml"

from pathlib import Path

scenario_path = config.get("scenario", "config/scenarios/legacy_reproduction.yaml")
scenario = __import__("yaml").safe_load(Path(scenario_path).read_text(encoding="utf-8"))
setup_log = scenario["outputs"]["setup_log"]


rule all:
    input:
        setup_log


rule setup_smoke:
    output:
        setup_log
    shell:
        "uv run python src/setup.py --scenario {scenario_path}"


rule fetch_ontario_vehicle_population:
    output:
        manifest="inputs/interim/fetched_ontario_vehicle_population/manifest.csv",
        report4="inputs/interim/fetched_ontario_vehicle_population/ontario_vehicle_population_report4_epa_gvwr_distribution_{year}.csv",
        report5="inputs/interim/fetched_ontario_vehicle_population/ontario_vehicle_population_report5_age_distribution_{year}.csv",
    params:
        scenario=scenario_path
    shell:
        "uv run python -m parameterization.ontario_vehicle_population --scenario {params.scenario} --year {wildcards.year}"
