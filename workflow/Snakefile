from pathlib import Path

from fetching.cer_enerfuture import build_requests as cer_requests, configured_edition
from fetching.statcan_tables import build_requests as statcan_requests
from fetching.greet_vehicle_cycle import required_inputs as embodied_inputs
from fetching.legacy_charging_profiles import required_inputs as charging_inputs
from fetching.epa_omega_baseline import required_inputs as range_inputs
from parameterization.manual_parameters import registered_manual_components
from utils import load_config_bundle, load_harmonization_rules


SCENARIO_PATH = config.get(
    "scenario",
    "config/scenarios/legacy_reproduction.yaml",
)
SCENARIO = load_config_bundle(SCENARIO_PATH)
CER_EDITION = str(configured_edition(SCENARIO))
CER_RULES = load_harmonization_rules(SCENARIO, "cer_enerfuture")
STATCAN_RULES = load_harmonization_rules(SCENARIO, "statcan_tables")
INTERIM_ROOT = SCENARIO.paths.inputs.interim.rstrip("/\\")
LOG_ROOT = SCENARIO.paths.outputs.logs.rstrip("/\\")
SQLITE_ROOT = SCENARIO.paths.outputs.sqlite.rstrip("/\\")
CER_INTERIM = (
    f"{INTERIM_ROOT}/"
    f"{CER_RULES['interim_subdir_template'].format(edition=CER_EDITION)}"
)
STATCAN_INTERIM = f"{INTERIM_ROOT}/{STATCAN_RULES['interim_subdir']}"
STATCAN_MANIFEST = f"{STATCAN_INTERIM}/{STATCAN_RULES['manifest_file']}"
STATCAN_WARNINGS = f"{STATCAN_INTERIM}/{STATCAN_RULES['warnings_file']}"
CER_MANIFEST = f"{CER_INTERIM}/{CER_RULES['manifest_file']}"
CER_WARNINGS = f"{CER_INTERIM}/{CER_RULES['warnings_file']}"
DOCTOR_OUTPUT = f"{LOG_ROOT}/doctor_{SCENARIO.scenario.scenario.name}.ok"
TRANSPORT_DATABASE = f"{SQLITE_ROOT}/{SCENARIO.scenario.outputs.sqlite_name}"
TRANSPORT_VALIDATION = SCENARIO.scenario.outputs.validation_report
DOWNLOAD_SETTING = config.get("download_sources", False)
if DOWNLOAD_SETTING not in (True, False, "true", "false"):
    raise ValueError("download_sources must be true or false")
DOWNLOAD_SOURCES = DOWNLOAD_SETTING in (True, "true")
CACHE_FLAG = "" if DOWNLOAD_SOURCES else "--no-download"
PARAMETER_ROOT = SCENARIO.paths.config.parameters
CONFIG_INPUTS = [
    "config/paths.yaml", "config/sources.yaml", SCENARIO_PATH,
    f"{PARAMETER_ROOT}/rules.yaml",
]
CONVERSION_INPUT = f"{PARAMETER_ROOT}/conversion.yaml"
MANUAL_INPUTS = sorted({
    f"{SCENARIO.paths.inputs.manual}/{registration.adapter.manual_parameter_path}"
    for registration in registered_manual_components(SCENARIO)
    if not registration.adapter.development_only
} | {
    f"{SCENARIO.paths.inputs.manual}/{filename}"
    for filename in load_harmonization_rules(SCENARIO, "manual_parameters")[
        "internal_assumption_files"
    ]
})
TEMPLATE_INPUTS = [
    f"{SCENARIO.paths.inputs.template}/{filename}"
    for filename in ("technology.csv", "commodity.csv", "region.csv", "time_period.csv")
]
EMBODIED_INPUTS = [str(path.relative_to(SCENARIO.repo_root)) for path in embodied_inputs(SCENARIO)]
CHARGING_INPUTS = [str(path.relative_to(SCENARIO.repo_root)) for path in charging_inputs(SCENARIO)]
RANGE_INPUTS = [str(path.relative_to(SCENARIO.repo_root)) for path in range_inputs(SCENARIO)]
COMMON_CODE = ["pyproject.toml", "uv.lock"] + sorted(
    path.as_posix()
    for directory in ("src/utils", "src/validation")
    for path in Path(directory).glob("*.py")
)
CER_REQUESTS = cer_requests(SCENARIO)
STATCAN_REQUESTS = statcan_requests(SCENARIO)
CER_TABLES = [f"{CER_INTERIM}/{request.output_file}" for request in CER_REQUESTS]
STATCAN_TABLES = [
    f"{STATCAN_INTERIM}/{request.output_file}" for request in STATCAN_REQUESTS
] + [
    f"{STATCAN_INTERIM}/{filename}"
    for filename in (
        STATCAN_RULES["ldv_history"]["output_file"],
        STATCAN_RULES["ldv_history"]["overlap_file"],
        STATCAN_RULES["freight"]["output_file"],
    )
]


rule all:
    input:
        DOCTOR_OUTPUT,
        STATCAN_TABLES,
        STATCAN_MANIFEST,
        STATCAN_WARNINGS,
        CER_TABLES,
        CER_MANIFEST,
        CER_WARNINGS,
        TRANSPORT_DATABASE,
        TRANSPORT_VALIDATION,


rule doctor_smoke:
    input:
        controls=CONFIG_INPUTS,
        manual=MANUAL_INPUTS,
        templates=TEMPLATE_INPUTS,
        code=COMMON_CODE + ["scripts/doctor.py", "src/parameterization/manual_parameters.py"],
    output:
        DOCTOR_OUTPUT
    params:
        scenario=SCENARIO_PATH,
    run:
        import subprocess

        subprocess.run(
            ["uv", "run", "python", "scripts/doctor.py", "--scenario", params.scenario],
            check=True,
        )
        output_path = Path(output[0])
        output_path.parent.mkdir(parents=True, exist_ok=True)
        output_path.write_text("ok\n", encoding="utf-8")


rule statcan_transport_tables:
    input:
        controls=CONFIG_INPUTS + [CONVERSION_INPUT],
        code=COMMON_CODE + ["src/fetching/statcan_tables.py"],
        cache=[] if DOWNLOAD_SOURCES else [
            str(path) for request in STATCAN_REQUESTS
            for path in (request.archive_cache_path, request.metadata_cache_path)
        ],
    output:
        tables=STATCAN_TABLES,
        manifest=STATCAN_MANIFEST,
        warnings=STATCAN_WARNINGS,
    params:
        scenario=SCENARIO_PATH,
        cache_flag=CACHE_FLAG,
    shell:
        "uv run python -m fetching.statcan_tables "
        "--scenario {params.scenario:q} {params.cache_flag}"


rule cer_enerfuture:
    input:
        controls=CONFIG_INPUTS,
        code=COMMON_CODE + ["src/fetching/cer_enerfuture.py"],
        cache=[] if DOWNLOAD_SOURCES else [str(request.cache_path) for request in CER_REQUESTS],
    output:
        tables=CER_TABLES,
        manifest=CER_MANIFEST,
        warnings=CER_WARNINGS,
    params:
        scenario=SCENARIO_PATH,
        edition=CER_EDITION,
        cache_flag=CACHE_FLAG,
    shell:
        "uv run python -m fetching.cer_enerfuture "
        "--scenario {params.scenario:q} --edition {params.edition:q} "
        "{params.cache_flag}"


rule transport_database:
    input:
        doctor=DOCTOR_OUTPUT,
        statcan=rules.statcan_transport_tables.output,
        cer=rules.cer_enerfuture.output,
        scenario=SCENARIO_PATH,
        conversion=CONVERSION_INPUT,
        templates=TEMPLATE_INPUTS,
        embodied=EMBODIED_INPUTS,
        charging=CHARGING_INPUTS,
        range_evidence=RANGE_INPUTS,
        code=[
            "src/build_transport.py",
            # Selection/normalization helpers used by parameter preparation.
            "src/fetching/nlr_atb_autonomie.py",
            "src/fetching/fueleconomy_vehicles.py",
            "src/fetching/greet_vehicle_cycle.py",
            "src/fetching/greet_automation.py",
            "src/fetching/legacy_charging_profiles.py",
            "src/fetching/epa_omega_baseline.py",
        ] + sorted(
            path.as_posix() for path in Path("src/parameterization").glob("*.py")
            if path.stem != "vehicle_mapping_bootstrap"
        ),
    output:
        database=update(TRANSPORT_DATABASE),
        validation=update(TRANSPORT_VALIDATION),
    shell:
        "uv run python src/build_transport.py "
        "--scenario {input.scenario:q} --overwrite"
